Dockerfile
.dockerignore
# app.py and README.md are deliberately NOT excluded. Hugging Face builds Gradio
# Spaces with Docker and honours this file, so excluding app.py here removed the
# Space's entrypoint from its build context — the container started and reported
# "can't open file '/home/user/app/app.py'" while the file sat in the repo.
