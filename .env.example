PATENTLY_LLM_PROVIDER=gemini

GEMINI_API_KEY=
OPENAI_API_KEY=

PATENTLY_GEMINI_MODEL=gemini-3.5-flash-lite
PATENTLY_OPENAI_MODEL=gpt-5.4-mini


QDRANT_PATH=./.qdrant
# QDRANT_URL=
# QDRANT_API_KEY=

# --- saved analyses (optional) ----------------------------------------------
# Unset, the app works exactly as before and simply doesn't save anything.
# Managed providers' URLs (Neon, Supabase) work as pasted — the ?sslmode= and
# ?channel_binding= parameters are translated for asyncpg, which doesn't
# understand libpq syntax.
DATABASE_URL=

# Recorded on every saved analysis, so an old verdict still says what it was
# searched against. Change it whenever the indexed corpus changes.
# PATENTLY_CORPUS=big_patent:g

# --- optional ---------------------------------------------------------------
# PATENTLY_ASSESS_TOP_K=12          # candidates sent to the assessment call
# PATENTLY_RETRIEVE_PER_QUERY=25    # per-angle retrieval depth before fusion
# PATENTLY_DATASET=big_patent
# PATENTLY_DATASET_CONFIG=g
